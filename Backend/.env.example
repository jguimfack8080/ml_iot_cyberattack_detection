# Copy to .env and adjust paths for your environment
# Never commit .env to version control

# Path to the MERGED_CSV directory (absolute or relative to Backend/)
DATA_DIR=../Dataset/MERGED_CSV

# Output directories
RESULTS_DIR=results
MODELS_DIR=models_artifacts

# Reproducibility
RANDOM_STATE=42

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
